<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LOCAL TEST BUILDS ONLY (ALLOW_NONSYSTEM_LIBS=1): lets a helper linked to
     Homebrew libraries (OpenSSL, before work package N2) load them under the
     hardened runtime's library validation. Never used for a release. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
